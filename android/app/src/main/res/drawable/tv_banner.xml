<?xml version="1.0" encoding="utf-8"?>
<!-- באנר לשורת היישומים ב-Android TV (320x180dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#212C56"
